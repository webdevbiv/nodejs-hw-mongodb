{
  "openapi": "3.0.3",
  "info": {
    "title": "Contacts API (HW-07)",
    "version": "1.0.0",
    "description": "REST API for auth and contacts CRUD with optional photo upload.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://<your-render-app>.onrender.com",
      "description": "Production (Render)"
    },
    {
      "url": "http://localhost:8080",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health and service metadata"
    },
    {
      "name": "Auth",
      "description": "User authentication and session management"
    },
    {
      "name": "Contacts",
      "description": "CRUD for contacts and photo upload"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "operationId": "healthCheck",
        "security": [],
        "responses": {
          "200": {
            "description": "OK — server is running",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Contacts API is running."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a user",
        "operationId": "registerUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              },
              "examples": {
                "sample": {
                  "value": {
                    "name": "Igor",
                    "email": "igor@example.com",
                    "password": "secret123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "examples": {
                  "created": {
                    "value": {
                      "_id": "66b2f0c0c5a0d94d2b8c1234",
                      "name": "Igor",
                      "email": "igor@example.com",
                      "avatarURL": null,
                      "createdAt": "2025-08-16T09:15:27.000Z",
                      "updatedAt": "2025-08-16T09:15:27.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login and get tokens",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              },
              "examples": {
                "sample": {
                  "value": {
                    "email": "igor@example.com",
                    "password": "secret123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access.payload.sig",
                      "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.sig",
                      "user": {
                        "_id": "66b2f0c0c5a0d94d2b8c1234",
                        "name": "Igor",
                        "email": "igor@example.com",
                        "avatarURL": null,
                        "createdAt": "2025-08-16T09:15:27.000Z",
                        "updatedAt": "2025-08-16T09:15:27.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh session using refresh token",
        "operationId": "refreshSession",
        "description": "Uses HTTP-only refresh token cookie to issue new access/refresh tokens.",
        "security": [],
        "responses": {
          "200": {
            "description": "Session refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "refreshed": {
                    "value": {
                      "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new.access.sig",
                      "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new.refresh.sig",
                      "user": {
                        "_id": "66b2f0c0c5a0d94d2b8c1234",
                        "name": "Igor",
                        "email": "igor@example.com",
                        "avatarURL": null,
                        "createdAt": "2025-08-16T09:15:27.000Z",
                        "updatedAt": "2025-08-16T09:15:27.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout (invalidate session)",
        "operationId": "logoutUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "List contacts",
        "operationId": "listContacts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "favorite",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by favorite flag"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Contact"
                          }
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "list": {
                    "value": {
                      "status": "success",
                      "message": "Successfully found contacts!",
                      "data": [
                        {
                          "_id": "66b2f0c0c5a0d94d2b8c5678",
                          "name": "John Doe",
                          "email": "john@example.com",
                          "phone": "+380501112233",
                          "favorite": false,
                          "photo": null,
                          "createdAt": "2025-08-16T09:15:27.000Z",
                          "updatedAt": "2025-08-16T09:15:27.000Z"
                        },
                        {
                          "_id": "66b2f0c0c5a0d94d2b8c5679",
                          "name": "Jane Smith",
                          "email": "jane@example.com",
                          "phone": "+380971112233",
                          "favorite": true,
                          "photo": "https://res.cloudinary.com/demo/image/upload/sample.jpg",
                          "createdAt": "2025-08-16T10:12:05.000Z",
                          "updatedAt": "2025-08-16T10:12:05.000Z"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create contact (JSON or multipart)",
        "operationId": "createContact",
        "description": "Accepts JSON or multipart/form-data with a `photo` file. If a file is provided, the server uploads it (e.g., to Cloudinary) and stores the URL.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContactJSON"
              },
              "examples": {
                "sample": {
                  "value": {
                    "name": "John Doe",
                    "email": "john@example.com",
                    "phone": "+380501112233",
                    "favorite": false
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "phone"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "favorite": {
                    "type": "boolean"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Contact photo file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Contact"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "created": {
                    "value": {
                      "status": "success",
                      "message": "Successfully created a contact!",
                      "data": {
                        "_id": "66b2f0c0c5a0d94d2b8c5680",
                        "name": "John Doe",
                        "email": "john@example.com",
                        "phone": "+380501112233",
                        "favorite": false,
                        "photo": null,
                        "createdAt": "2025-08-16T11:03:44.000Z",
                        "updatedAt": "2025-08-16T11:03:44.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "parameters": [
        {
          "in": "path",
          "name": "contactId",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Mongo ObjectId of the contact"
        }
      ],
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get contact by id",
        "operationId": "getContactById",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Contact"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "found": {
                    "value": {
                      "status": "success",
                      "message": "Contact with ID 66b2f0c0c5a0d94d2b8c5678 found",
                      "data": {
                        "_id": "66b2f0c0c5a0d94d2b8c5678",
                        "name": "John Doe",
                        "email": "john@example.com",
                        "phone": "+380501112233",
                        "favorite": false,
                        "photo": null,
                        "createdAt": "2025-08-16T09:15:27.000Z",
                        "updatedAt": "2025-08-16T09:15:27.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "tags": [
          "Contacts"
        ],
        "summary": "Update contact (JSON or multipart)",
        "operationId": "updateContact",
        "description": "Accepts JSON fields and/or multipart/form-data with a `photo` file to replace the existing contact photo.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateContactJSON"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "favorite": {
                    "type": "boolean"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "New contact photo file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Contact"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "updated": {
                    "value": {
                      "status": "success",
                      "message": "Successfully patched a contact!",
                      "data": {
                        "_id": "66b2f0c0c5a0d94d2b8c5678",
                        "name": "Johnathan Doe",
                        "email": "john.new@example.com",
                        "phone": "+380501112299",
                        "favorite": true,
                        "photo": "https://res.cloudinary.com/demo/image/upload/sample.jpg",
                        "createdAt": "2025-08-16T09:15:27.000Z",
                        "updatedAt": "2025-08-16T12:45:10.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Delete contact",
        "operationId": "deleteContact",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "Public user representation returned by the API.",
        "required": [
          "_id",
          "name",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "type": "string",
            "description": "Mongo ObjectId",
            "pattern": "^[a-f0-9]{24}$",
            "readOnly": true,
            "example": "66b2f0c0c5a0d94d2b8c1234"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Igor"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "igor@example.com"
          },
          "avatarURL": {
            "type": "string",
            "format": "uri-reference",
            "nullable": true,
            "description": "Public URL to the user's avatar (local or CDN)",
            "example": "/avatars/1723819200-ava.png"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2025-08-16T09:15:27.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2025-08-16T09:15:27.000Z"
          }
        }
      },
      "RegisterBody": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "example": "Igor"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "igor@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128,
            "example": "secret123"
          }
        }
      },
      "LoginBody": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "igor@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128,
            "example": "secret123"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "user"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Contact": {
        "type": "object",
        "description": "Contact entity with optional hosted photo URL.",
        "required": [
          "_id",
          "name",
          "email",
          "phone",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "Mongo ObjectId",
            "example": "66b2f0c0c5a0d94d2b8c5678"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+380501112233"
          },
          "favorite": {
            "type": "boolean",
            "default": false,
            "example": false
          },
          "photo": {
            "type": "string",
            "nullable": true,
            "description": "Public URL to contact photo (e.g., Cloudinary)",
            "example": "https://res.cloudinary.com/demo/image/upload/sample.jpg"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-08-16T09:15:27.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-08-16T09:15:27.000Z"
          }
        }
      },
      "CreateContactJSON": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+380501112233"
          },
          "favorite": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "UpdateContactJSON": {
        "type": "object",
        "description": "Partial update payload for a contact.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "example": "Johnathan Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.new@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+380501112299"
          },
          "favorite": {
            "type": "boolean",
            "example": true
          },
          "photo": {
            "type": "string",
            "nullable": true,
            "description": "Optional direct URL to a photo (usually set by the server after multipart upload).\n"
          }
        }
      },
      "SuccessBase": {
        "type": "object",
        "description": "Standard success envelope fields.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "message": {
            "type": "string",
            "description": "Human-readable success message",
            "example": "Successfully found contacts!"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Bad Request"
                }
              }
            },
            "examples": {
              "badRequest": {
                "summary": "Validation error",
                "value": {
                  "status": "error",
                  "message": "Validation failed for one or more fields"
                }
              },
              "unauthorized": {
                "summary": "Unauthorized",
                "value": {
                  "status": "error",
                  "message": "Unauthorized"
                }
              },
              "notFound": {
                "summary": "Not found",
                "value": {
                  "status": "error",
                  "message": "Resource not found"
                }
              },
              "conflict": {
                "summary": "Conflict",
                "value": {
                  "status": "error",
                  "message": "Email in use"
                }
              },
              "invalidId": {
                "summary": "Invalid ObjectId",
                "value": {
                  "status": "error",
                  "message": "Invalid contact ID: 123"
                }
              }
            }
          }
        }
      }
    }
  }
}