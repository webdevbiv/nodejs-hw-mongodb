{
  "openapi": "3.0.3",
  "info": {
    "title": "Contacts API (HW-07)",
    "version": "1.0.0",
    "description": "REST API for auth and contacts CRUD with optional photo upload.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://contacts-xxm3.onrender.com",
      "description": "Production (Render)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health and service metadata"
    },
    {
      "name": "Auth",
      "description": "User authentication and session management"
    },
    {
      "name": "Contacts",
      "description": "CRUD for contacts and photo upload"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "operationId": "healthCheck",
        "security": [],
        "responses": {
          "200": {
            "description": "OK — server is running",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Contacts API is running."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a user",
        "operationId": "registerUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              },
              "examples": {
                "sample": {
                  "value": {
                    "name": "Igor",
                    "email": "igor@example.com",
                    "password": "secret123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "examples": {
                  "created": {
                    "value": {
                      "_id": "6892401c0134ece992c7de3d",
                      "name": "Igor",
                      "email": "igor@example.com",
                      "createdAt": "2025-08-05T17:32:12.584Z",
                      "updatedAt": "2025-08-05T17:32:12.584Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login and get tokens",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              },
              "examples": {
                "sample": {
                  "value": {
                    "email": "igor@example.com",
                    "password": "secret123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access.payload.sig",
                      "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.sig",
                      "user": {
                        "_id": "6892401c0134ece992c7de3d",
                        "name": "Igor",
                        "email": "igor@example.com",
                        "createdAt": "2025-08-05T17:32:12.584Z",
                        "updatedAt": "2025-08-05T17:32:12.584Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh session using refresh token",
        "operationId": "refreshSession",
        "description": "Uses HTTP-only refresh token cookie to issue new access/refresh tokens.",
        "security": [],
        "responses": {
          "200": {
            "description": "Session refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "refreshed": {
                    "value": {
                      "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new.access.sig",
                      "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new.refresh.sig",
                      "user": {
                        "_id": "6892401c0134ece992c7de3d",
                        "name": "Igor",
                        "email": "igor@example.com",
                        "createdAt": "2025-08-05T17:32:12.584Z",
                        "updatedAt": "2025-08-05T17:32:12.584Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout (invalidate session)",
        "operationId": "logoutUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "List contacts (paginated)",
        "operationId": "listContacts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "isFavourite",
            "description": "Filter by favourite flag",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "page",
            "description": "Page number (1-based)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Items per page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "required": [
                            "contacts",
                            "page",
                            "limit",
                            "totalItems",
                            "totalPages"
                          ],
                          "properties": {
                            "contacts": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Contact"
                              }
                            },
                            "page": {
                              "type": "integer",
                              "example": 1
                            },
                            "limit": {
                              "type": "integer",
                              "example": 20
                            },
                            "totalItems": {
                              "type": "integer",
                              "example": 42
                            },
                            "totalPages": {
                              "type": "integer",
                              "example": 3
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "list": {
                    "value": {
                      "status": "success",
                      "message": "Successfully found contacts!",
                      "data": {
                        "contacts": [
                          {
                            "_id": "66b2f0c0c5a0d94d2b8c5678",
                            "name": "Alice Test",
                            "email": "alice@example.com",
                            "phoneNumber": "+380501234567",
                            "isFavourite": true,
                            "contactType": "work",
                            "photo": "https://res.cloudinary.com/demo/image/upload/sample.jpg",
                            "userId": "6698c7360e59d8758205404f",
                            "createdAt": "2025-08-14T19:10:04.073Z",
                            "updatedAt": "2025-08-14T19:34:07.478Z"
                          },
                          {
                            "_id": "66b2f0c0c5a0d94d2b8c5679",
                            "name": "Bob",
                            "email": "bob@example.com",
                            "phoneNumber": "+380971112233",
                            "isFavourite": false,
                            "contactType": "home",
                            "photo": null,
                            "userId": "6698c7360e59d8758205404f",
                            "createdAt": "2025-08-15T12:19:59.205Z",
                            "updatedAt": "2025-08-15T12:19:59.205Z"
                          }
                        ],
                        "page": 1,
                        "limit": 20,
                        "totalItems": 42,
                        "totalPages": 3
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create contact (multipart/form-data)",
        "operationId": "createContact",
        "description": "Accepts multipart/form-data only. Send only fields that are actually posted. Server stores uploaded `photo` and saves its URL to the contact.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "phoneNumber"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Alice Test"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "alice@example.com"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "example": "+380501234567"
                  },
                  "isFavourite": {
                    "type": "boolean",
                    "example": true
                  },
                  "contactType": {
                    "type": "string",
                    "description": "One of: work, home, personal, etc.",
                    "example": "work"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Contact photo file"
                  }
                }
              },
              "encoding": {
                "photo": {
                  "contentType": "image/jpeg, image/png, image/webp"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Contact"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "created": {
                    "value": {
                      "status": "success",
                      "message": "Successfully created a contact!",
                      "data": {
                        "_id": "66b2f0c0c5a0d94d2b8c5680",
                        "name": "Alice Test",
                        "email": "alice@example.com",
                        "phoneNumber": "+380501234567",
                        "isFavourite": true,
                        "contactType": "work",
                        "photo": "https://res.cloudinary.com/demo/image/upload/sample.jpg",
                        "userId": "6698c7360e59d8758205404f",
                        "createdAt": "2025-08-16T11:03:44.000Z",
                        "updatedAt": "2025-08-16T11:03:44.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "patch": {
        "tags": [
          "Contacts"
        ],
        "summary": "Update contact by id (multipart/form-data)",
        "operationId": "updateContact",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "description": "Contact ID (Mongo ObjectId)",
            "schema": {
              "type": "string",
              "example": "66b2f0c0c5a0d94d2b8c5678"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "description": "Send only fields you actually update.",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Alice Test"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "alice@example.com"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "example": "+380501234567"
                  },
                  "isFavourite": {
                    "type": "boolean",
                    "example": true
                  },
                  "contactType": {
                    "type": "string",
                    "description": "One of: work, home, personal, etc.",
                    "example": "work"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "New contact photo file"
                  }
                }
              },
              "encoding": {
                "photo": {
                  "contentType": "image/jpeg, image/png, image/webp"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully patched a contact.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessBase"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Contact"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "updated": {
                    "value": {
                      "status": "success",
                      "message": "Successfully patched a contact!",
                      "data": {
                        "_id": "66b2f0c0c5a0d94d2b8c5678",
                        "name": "Alice Test",
                        "email": "alice@example.com",
                        "phoneNumber": "+380501234567",
                        "isFavourite": true,
                        "contactType": "work",
                        "photo": "https://res.cloudinary.com/demo/image/upload/sample.jpg",
                        "userId": "6698c7360e59d8758205404f",
                        "createdAt": "2025-08-14T19:10:04.073Z",
                        "updatedAt": "2025-08-16T12:00:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "Public user representation returned by the API.",
        "required": [
          "_id",
          "name",
          "email",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "type": "string",
            "description": "Mongo ObjectId",
            "pattern": "^[a-f0-9]{24}$",
            "readOnly": true,
            "example": "6892401c0134ece992c7de3d"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Igor Berezhnoy"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "igor@example.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2025-08-05T17:32:12.584Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2025-08-05T17:32:12.584Z"
          }
        }
      },
      "RegisterBody": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "example": "Igor"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "igor@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128,
            "example": "secret123"
          }
        }
      },
      "LoginBody": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "igor@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128,
            "example": "secret123"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "user"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Contact": {
        "type": "object",
        "description": "Contact entity with optional hosted photo URL.",
        "required": [
          "_id",
          "name",
          "email",
          "phoneNumber",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "type": "string",
            "description": "Mongo ObjectId",
            "pattern": "^[a-f0-9]{24}$",
            "readOnly": true,
            "example": "66b2f0c0c5a0d94d2b8c5678"
          },
          "name": {
            "type": "string",
            "example": "Alice Test"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "phoneNumber": {
            "type": "string",
            "description": "International phone in E.164 or similar format",
            "example": "+380501234567"
          },
          "isFavourite": {
            "type": "boolean",
            "default": false,
            "example": true
          },
          "contactType": {
            "type": "string",
            "description": "Arbitrary label for the contact (e.g., work/home)",
            "example": "work"
          },
          "photo": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Public URL to contact photo (e.g., Cloudinary)",
            "example": "https://res.cloudinary.com/demo/image/upload/sample.jpg"
          },
          "userId": {
            "type": "string",
            "description": "Owner user id (Mongo ObjectId)",
            "pattern": "^[a-f0-9]{24}$",
            "readOnly": true,
            "example": "6698c7360e59d8758205404f"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2025-08-14T19:10:04.073Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2025-08-14T19:34:07.478Z"
          }
        }
      },
      "CreateContactJSON": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phoneNumber"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "example": "Alice Test"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+380501234567"
          },
          "isFavourite": {
            "type": "boolean",
            "default": false,
            "example": true
          },
          "contactType": {
            "type": "string",
            "example": "work"
          },
          "photo": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Optional direct URL; usually set by server after file upload"
          }
        }
      },
      "UpdateContactJSON": {
        "type": "object",
        "description": "Partial update payload for a contact.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "example": "Alice Test"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+380500000000"
          },
          "isFavourite": {
            "type": "boolean",
            "example": true
          },
          "contactType": {
            "type": "string",
            "example": "work"
          },
          "photo": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Optional direct URL (usually set by the server after multipart upload)"
          }
        }
      },
      "SuccessBase": {
        "type": "object",
        "description": "Standard success envelope fields.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "message": {
            "type": "string",
            "description": "Human-readable success message",
            "example": "Successfully found contacts!"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Bad Request"
                }
              }
            },
            "examples": {
              "badRequest": {
                "summary": "Validation error",
                "value": {
                  "status": "error",
                  "message": "Validation failed for one or more fields"
                }
              },
              "unauthorized": {
                "summary": "Unauthorized",
                "value": {
                  "status": "error",
                  "message": "Unauthorized"
                }
              },
              "notFound": {
                "summary": "Not found",
                "value": {
                  "status": "error",
                  "message": "Resource not found"
                }
              },
              "conflict": {
                "summary": "Conflict",
                "value": {
                  "status": "error",
