# Server settings
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# JWT secrets
ACCESS_SECRET=your_access_secret
REFRESH_SECRET=your_refresh_secret

# JWT expiration times
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d

# MongoDB connection
MONGODB_USER=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URL=mongodb+srv://<MONGODB_USER>:<MONGODB_PASSWORD>@practice01.pssemde.mongodb.net/<MONGODB_DB>?retryWrites=true&w=majority&appName=practice01
MONGODB_DB=your_database_name

# SMTP Brevo for Nodemailer
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user_or_email
SMTP_PASSWORD=your_brevo_smtp_password
SMTP_FROM=your_verified_sender_email

# Password reset token
JWT_SECRET=your_strong_reset_jwt_secret

# Frontend domain used in reset link
APP_DOMAIN=http://localhost:3000/auth

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=contacts-photos
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
