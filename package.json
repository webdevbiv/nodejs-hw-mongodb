  "bugs": {
    "url": "https://github.com/webdevbiv/nodejs-hw-mongodb/issues"
  },
  "homepage": "https://github.com/webdevbiv/nodejs-hw-mongodb#readme",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@redocly/cli": "^2.0.5",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "nodemon": "^3.1.10"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "http-errors": "^2.0.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "mongoose": "^8.17.0",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "swagger-ui-express": "^5.0.1"
  }
}
